{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Health Millennium Platform FHIR R4 Capability Patient API",
    "version": "R4"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://authorization.cerner.com/tenants/{tenant}/protocols/oauth2/profiles/smart-v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Patient",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search or Read Patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://fhir-ehr.cerner.com/r4/Patient",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "query",
                "description": "Patient identifier."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Patient name."
              }
            ]
          },
          "docs": "Search or read Patient resources."
        }
      ]
    }
  ],
  "bundled": true
}